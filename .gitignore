# 上游参考仓库（仅本地研读，不入库）
.upstream/

# 产物
*.mo.bak
locale/**/*.mo~

# 文档站的 node 依赖（site/.gitignore 里也有一份，双保险）
site/node_modules/

# 本地运行时落在仓库根的临时件（内容是 skill 清单，不是仓库产物）
.DOCS.*

# 凭据文件不入库。门禁 tools/check_security.sh 的 secret.tracked 查的是「已经入库的」，
# 这里管的是「还没入库的」—— 忽略规则不能只靠评审兜着。
.env
.env.*
!.env.example
*.pem
*.key
# 构建与签名产物：只进 release 资产，绝不进版本库（sign_release / package_tarball 本地跑出来的东西）
dist/
*.minisig
id_rsa
id_dsa
id_ecdsa
id_ed25519

# 本机工作文档（设计稿、批次清单），不进分发包也不进文档门禁
.superpowers/

# macOS 桌面元数据：Finder 会随手在仓库里生成 .DS_Store。
# 它会让 tools/release.sh 的「工作树必须干净」检查（git status --porcelain 含未跟踪文件）
# 直接判脏 ⇒ macOS 上发版永远起不来，且报错信息与真实原因（一个 6 KB 的元数据文件）
# 完全对不上。
.DS_Store

