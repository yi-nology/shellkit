#!/usr/bin/env bash
#
# 部署工具的入口。只做三件事：定位自身、加载库、交给 cli_run。
set -euo pipefail

SELF=$(cd "$(dirname "$0")" && pwd)
HOME_DIR=$(cd "$SELF/.." && pwd)

# 这是仓库内的示例，库用相对路径加载。拿去用之前先 `shellkit vendor .`，
# 再把下面这行换成 vendor/shellkit/lib/bootstrap.sh（见 README）。
. "$HOME_DIR/../../lib/bootstrap.sh"

cli_group "服务"
cli_cmd deploy "安装并启用服务" "deploy <name>"
cli_cmd status "查看服务是否已安装" "status <name>"

for __file in "$HOME_DIR"/commands/*.sh; do
  . "$__file"
done

cli_run "$@"
